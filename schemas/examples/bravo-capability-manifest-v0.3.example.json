      "selectable": true,
      "availability": "available",
      "parameters": [
        {
          "name": "material",
          "type": "string",
          "required": true
        },
        {
          "name": "anchor",
          "type": "string",
          "required": true
        },
        {
          "name": "volume_ul",
          "type": "number",
          "required": true,
          "unit": "uL"
        },
        {
          "name": "cycles",
          "type": "integer",
          "required": true
        },
        {
          "name": "method_ref",
          "type": "object",
          "required": false
        }
      ],
      "preconditions": [
        "disposable_head",
