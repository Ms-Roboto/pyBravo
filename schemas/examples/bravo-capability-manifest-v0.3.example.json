  "assistant_operations": [
    {
      "id": "transfer",
      "description": "Move a per-channel volume between addressed source and destination wells.",
      "selectable": true,
      "availability": "available",
      "parameters": [
        {
          "name": "source",
          "type": "string",
          "required": true
        },
        {
          "name": "destination",
          "type": "string",
          "required": true
        },
        {
          "name": "source_anchor",
          "type": "string",
          "required": true
        },
        {
          "name": "destination_anchor",
          "type": "string",
          "required": true
        },
        {
          "name": "volume_ul",
          "type": "number",
          "required": true,
          "unit": "uL"
        },
        {
          "name": "method_ref",
          "type": "object",
          "required": false
        }
      ],
      "preconditions": [
        "disposable_head",
        "compatible_tip_pair",
        "confirmed_tip_inventory",
        "approved_liquid_class",
        "reachable_wells",
        "source_and_destination_capacity"
      ],
      "effects": [
        "source_volume_decreased",
        "destination_volume_increased"
      ],
      "lowers_to": [
        "liquid/Aspirate",
        "liquid/Dispense"
      ]
    },
    {
      "id": "distribute",
      "description": "Dispense ordered volumes from one source; the compiler selects a safe aspiration pattern.",
      "selectable": true,
      "availability": "available",
      "parameters": [
        {
          "name": "source",
          "type": "string",
          "required": true
        },
        {
          "name": "source_anchor",
          "type": "string",
          "required": true
        },
        {
          "name": "dispenses",
          "type": "array",
          "required": true
        },
        {
          "name": "method_ref",
          "type": "object",
          "required": false
        }
      ],
      "preconditions": [
        "disposable_head",
        "compatible_tip_pair",
        "confirmed_tip_inventory",
        "approved_liquid_class",
        "reachable_wells",
        "source_and_destination_capacity",
        "distribute_volume_accounting"
      ],
      "effects": [
        "source_volume_decreased",
        "destination_volume_increased"
      ],
      "lowers_to": [
        "liquid/Aspirate",
        "liquid/Dispense"
      ]
    },
    {
      "id": "mix",
