  "setup_decision_rules": [
    {
      "id": "head_mode_full_footprint",
      "decision": "/setup/head_mode",
      "when": {
        "all": [
          {
            "fact": "liquid_step_count",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "full_head_footprint",
            "op": "eq",
            "value": true
          }
        ]
      },
      "recommendation": {
        "subset_type": "all_barrels",
        "subset_config": "back_left",
        "row_count": null,
        "column_count": null
      },
      "evidence_level": "heuristic",
      "requires_confirmation": true,
      "rationale": "An affirmative all-wells instruction and matching catalog grid suggest all barrels; the scientist must confirm intended coverage. The back-left corner is canonical, and row and column counts come from the configured head rather than setup entry.",
      "provenance": [
        "pybravo.head_mode.normalize_head_mode",
        "pybravo.workflow.protocols.validation"
      ],
      "required_evidence": [
        "Affirmative source evidence or a structured scientist decision states full-head coverage for every liquid step on verified plate grids."
      ]
    },
    {
      "id": "head_mode_partial_selection",
      "decision": "/setup/head_mode",
      "when": {
        "all": [
          {
            "fact": "liquid_step_count",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "full_head_footprint",
            "op": "eq",
            "value": false
          }
        ]
      },
      "recommendation": null,
      "evidence_level": "scientist_input",
      "requires_confirmation": true,
      "rationale": "A partial footprint needs the intended channel shape, size and corner; plate well count alone does not identify which barrels should be active.",
      "provenance": [
        "pybravo.head_mode.normalize_head_mode",
        "pybravo.workflow.protocols.validation"
      ],
      "required_evidence": [
        "Intended active channels or target region, orientation and verified tip-rack footprint."
      ]
    },
    {
      "id": "tip_strategy_dedicated_source",
      "decision": "/setup/tip_strategy",
      "when": {
        "all": [
          {
            "fact": "liquid_step_count",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "source_count",
            "op": "gte",
            "value": 2
          },
          {
            "fact": "dedicated_tip_rack_per_source",
            "op": "eq",
            "value": true
          },
          {
            "fact": "destination_initially_empty",
            "op": "eq",
            "value": true
          },
          {
            "fact": "same_source_reuse_authorized",
            "op": "eq",
            "value": true
          }
        ]
      },
      "recommendation": "fresh_each_source",
      "evidence_level": "heuristic",
      "requires_confirmation": true,
      "rationale": "A dedicated tip set per source isolates sources while allowing that set to dispense into initially empty destinations. Reuse still needs the scientist's contamination assessment.",
      "provenance": [
        "pybravo.workflow.protocols.validation",
        "scientist_confirmed_reuse_intent"
      ],
      "required_evidence": [
        "One physically distinct compatible rack per source in execution order.",
        "Scientist authorization to reuse only within the same source.",
        "Destination plates are initially empty and the procedure does not mix sources through tips."
      ]
    },
    {
      "id": "tip_strategy_fresh_step",
      "decision": "/setup/tip_strategy",
      "when": {
        "all": [
          {
            "fact": "liquid_step_count",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "same_source_reuse_authorized",
            "op": "eq",
            "value": false
          }
        ]
      },
      "recommendation": "fresh_each_step",
      "evidence_level": "heuristic",
      "requires_confirmation": true,
      "rationale": "Fresh tips for each liquid step avoid assumed reuse. The plan must have enough confirmed compatible tips for every pickup.",
      "provenance": [
        "pybravo.workflow.protocols.validation"
      ],
      "required_evidence": [
        "Explicit decision not to reuse tips within a source.",
        "Sufficient inspected fresh-tip footprints for every liquid step."
      ]
    },
    {
      "id": "tip_strategy_quadrant_conditional",
      "decision": "/setup/tip_strategy",
      "when": {
        "all": [
          {
            "fact": "liquid_step_count",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "four_source_quadrant_recipe",
            "op": "eq",
            "value": true
          },
          {
            "fact": "four_source_five_ul_pairings",
            "op": "eq",
            "value": true
          },
          {
            "fact": "full_head_footprint",
            "op": "eq",
            "value": true
          },
          {
            "fact": "dedicated_tip_rack_per_source",
            "op": "eq",
            "value": true
          },
          {
            "fact": "st10_384_dedicated_racks",
            "op": "eq",
            "value": true
          },
          {
            "fact": "destination_footprints_disjoint",
            "op": "eq",
            "value": true
          },
          {
            "fact": "no_recorded_destination_liquid",
            "op": "eq",
            "value": true
          },
          {
            "fact": "same_source_reuse_prohibited",
            "op": "eq",
            "value": false
          }
        ]
      },
      "recommendation": "fresh_each_source",
      "evidence_level": "heuristic",
      "requires_confirmation": true,
      "rationale": "The four-source quadrant recipe can isolate sources with one dedicated ST tip set per source. This is a conditional draft choice: confirm both destinations start empty, each dispense avoids contact with destination liquid, and the same source's tip set may serve both plates. Two 5 µL dispenses exactly fill a nominal ST10 tip, leaving no allowance for residual liquid or an air gap. Keep two separate 5 µL aspirations unless a reviewed method proves a shared aspiration safe. A contamination assessment is still required before execution.",
      "provenance": [
        "config/protocol_recipes.yaml#four_384_to_1536_quadrants",
        "cited_protocol_text",
        "active_head_catalog_pair"
      ],
      "required_evidence": [
        "Scientist confirms both destination plates start empty and records their starting volumes.",
        "Selected dispense method avoids destination-liquid contact or has a reviewed carryover policy.",
        "Scientist records a same-source tip-reuse contamination assessment and confirms physical racks."
      ]
    },
    {
      "id": "tip_rack_order_by_source",
      "decision": "/setup/tip_rack_ids",
      "when": {
        "all": [
          {
            "fact": "liquid_step_count",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "source_count",
            "op": "gte",
            "value": 2
          },
          {
            "fact": "dedicated_tip_rack_per_source",
            "op": "eq",
            "value": true
          },
          {
            "fact": "tip_strategy",
            "op": "eq",
            "value": "fresh_each_source"
          }
        ]
      },
      "recommendation": {
        "resolver": "source_ordered_verified_tip_rack_ids"
      },
      "evidence_level": "heuristic",
      "requires_confirmation": true,
      "rationale": "Pair one exact catalog-compatible tip rack with each source in first-use order. A rack ID encoding its source ID is a review candidate, not a verified association; an explicit scientist mapping provides stronger evidence. Physical identity and inventory must be checked.",
      "provenance": [
        "pybravo.workflow.protocols.validation",
        "active_head_catalog_pair",
        "scientist_source_rack_mapping"
      ],
      "required_evidence": [
        "One distinct tip material and exact rack–tip catalog pair per source.",
        "Source execution order and rack order are both known.",
        "Physical rack contents and fresh-tip wells are confirmed before release."
      ]
    },
    {
      "id": "tip_disposal_return_to_source",
      "decision": "/setup/tip_disposal_id",
      "when": {
        "all": [
          {
            "fact": "liquid_step_count",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "tip_strategy",
            "op": "eq",
            "value": "fresh_each_source"
          },
          {
            "fact": "dedicated_tip_rack_per_source",
            "op": "eq",
            "value": true
          },
          {
            "fact": "waste_material_present",
            "op": "eq",
            "value": false
          }
        ]
      },
      "recommendation": "return_to_source_rack",
      "evidence_level": "heuristic",
      "requires_confirmation": true,
      "rationale": "With source-dedicated racks and no waste receptacle in the plan, spent tips can return to their original wells only if they will never be selected again.",
      "provenance": [
        "pybravo.workflow.protocols.validation"
